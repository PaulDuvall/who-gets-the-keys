+import { exec } from "node:child_process";
+
+/**
+ * Compresses a finished export file named by the request.
+ * @requirement SPEC-014-R1
+ */
+export function archiveExport(filename: string): Promise<void> {
+  return new Promise((done, fail) => {
+    exec(`gzip --keep ${filename}`, (err) => (err ? fail(err) : done()));
+  });
+}
